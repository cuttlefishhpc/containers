Bootstrap: localimage
From: raw.sif

%labels
    Author "Andrew S. Tupper, PhD"
    Version "1.0"
    Description "Container for running deeptools 3.5.5"
    Maintainer "Andrew S. Tupper <tuppera@uncw.edu>"
    License "MIT"

%post
    set -e
    
    echo "creating HPC mount points"
    mkdir -p /storage /scratch

%runscript
    if [ $# -eq 0 ]; then
        exec deeptools "$@"
    else
        exec "$@"
    fi

