Bootstrap: localimage
From: raw.sif

%labels
    Author "Andrew S. Tupper, PhD"
    Version "1.0"
    Description "Container for running hifiadapterfilt version 3.0.0"
    Maintainer "Andrew S. Tupper <tuppera@uncw.edu>"
    License "MIT"

%post
    set -e

    echo "creating HPC mount points"
    mkdir -p /storage /scratch
    
%runscript
    if [ $# -eq 0 ]; then
        echo "Usage: hifiadapterfilt@3.0.0 <command>"
        echo "Commands:"
        echo "  hifiadapterfilt.sh"
        echo "  hifiadapterfiltFCS.sh"
	echo ""
	echo "See https://github.com/sheinasim-USDA/HiFiAdapterFilt for example usage"
	echo ""
    else
        exec "$@"
    fi
