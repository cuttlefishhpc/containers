Bootstrap: docker
From: mambaorg/micromamba:ubuntu24.04

%labels
    Author "Andrew S. Tupper, PhD"
    Version "2.0"
    Description "Container for running Genespace 1.3.1"
    Maintainer "Andrew S. Tupper <tuppera@uncw.edu>"
    License "MIT"

%files
    install_genespace.R /opt/install_genespace.R

%post
    set -e

    echo "setting up micromamba"
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PATH=$MAMBA_ROOT_PREFIX/bin:$PATH
    
    echo "updating ubuntu"
    apt-get update && apt-get install -y git

    echo "Fix the missing timezone"
    apt-get install -y tzdata
    ln -sf /usr/share/zoneinfo/America/New_York /etc/localtime
    echo "America/New_York" > /etc/timezone


    echo "Installing conda packages using micromamba"
    micromamba install -y -n base -c conda-forge python=3.10
    micromamba install -y -n base -c conda-forge -c bioconda orthofinder=2.5
    micromamba install -y -n base -c conda-forge -c bioconda mcscanx
    micromamba install -y -n base -c conda-forge -c bioconda xz
    micromamba install -y -n base -c conda-forge -c bioconda r-base r-devtools r-biocmanager
    micromamba clean --all --yes

    echo "Install genespace using RScript"
    #eval "$(micromamba shell hook --shell )"
    #micromamba activate /opt/conda
    Rscript /opt/install_genespace.R

    echo "creating HPC mount points"
    mkdir -p /storage /scratch

%environment
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PATH=$MAMBA_ROOT_PREFIX/bin:$PATH
    export CONDA_DEFAULT_ENV=base

%runscript
    if [ $# -eq 0 ]; then
        exec /bin/bash
    else
        exec "$@"
    fi
